# tenant-fs-server configuration (.env)
# ---------------------------------------------------------------
# Copy this file to .env, edit, then run ./scripts/start.sh
# (or point systemd's EnvironmentFile at the .env path).
# Generate automatically with:  ./scripts/setup-env.sh
#
# Leave SERVER_SECRET / ADMIN_TOKEN blank to let setup-env.sh
# auto-generate them; if you write this file by hand they are required.
# Never commit .env to git.

# ---- required ----
# Root key: 32 random bytes as hex. Seals all app secrets and blobs.
# NEVER back it up together with the data (a backup without it is undecryptable).
TENANT_FS_SERVER_SECRET=

# Bearer token for the admin API. Keep it off the public network.
TENANT_FS_ADMIN_TOKEN=

# ---- network ----
# Public file API bind address.
TENANT_FS_PUBLIC_BIND=0.0.0.0:8080
# Admin API/console bind. Loopback only — the server refuses to start on a
# non-loopback address unless ALLOW_NON_LOOPBACK_ADMIN=true (dangerous).
TENANT_FS_ADMIN_BIND=127.0.0.1:8081
# DANGEROUS override: expose the admin surface beyond loopback.
TENANT_FS_ALLOW_NON_LOOPBACK_ADMIN=false
# Trust X-Forwarded-For for client IP. Enable only behind a trusted reverse proxy.
TENANT_FS_TRUST_XFF=false

# ---- storage ----
# SQLite database path.
TENANT_FS_DB=data/fs.db
# Blob storage root (sharded as app_<id>/yyyy/mm/<uuid>).
TENANT_FS_BLOBS=data/blobs
# Envelope-encrypt blobs at rest. Keep true.
TENANT_FS_ENCRYPT_BLOBS=true

# ---- security / limits ----
# Per-app budget per 60s window, shared by upload/generate/export/download. 0 = off.
TENANT_FS_RATE_LIMIT_PER_MIN=120
# Hard capacity of the in-memory rate-limit map.
TENANT_FS_RATE_LIMIT_MAX_ENTRIES=10000
# Max entries per batch-ACL call.
TENANT_FS_MAX_BATCH_ACL=1000

# ---- tokens ----
# Default embed-download token TTL (seconds).
TENANT_FS_EMBED_TTL=1800
# Default share-download token TTL (seconds).
TENANT_FS_SHARE_TTL=300
# Idempotency-Key reuse window (seconds).
TENANT_FS_IDEMPOTENCY_WINDOW_SECS=3600
# Idempotency-cache hard capacity.
TENANT_FS_IDEMPOTENCY_MAX_ENTRIES=10000
# Chunked-upload session TTL (seconds).
TENANT_FS_UPLOAD_TTL_SECS=86400
# Export artifact TTL (seconds).
TENANT_FS_EXPORT_TTL_SECS=86400
# Plaintext decrypt-cache TTL (seconds); swept by the maintenance loop.
TENANT_FS_DEC_CACHE_TTL_SECS=86400

# ---- retention / maintenance ----
# Audit-log retention (days).
TENANT_FS_AUDIT_RETENTION_DAYS=30
# Soft-delete grace before purge (days).
TENANT_FS_SOFT_DELETE_DAYS=7
# Maintenance loop interval (seconds).
TENANT_FS_PURGE_INTERVAL_SECS=600

# ---- backup ----
# Built-in backup output directory.
TENANT_FS_BACKUP_ROOT=data/backups
# Built-in backup retention (number kept).
TENANT_FS_BACKUP_RETENTION=7
# Scheduled built-in backups (seconds); 0 = off.
TENANT_FS_BACKUP_SCHEDULE_SECS=0
